{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the AQVN Workspace main window",
  "windows": ["main", "settings", "help", "about"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "shell:allow-open",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "store:default",
    "allow-open-settings",
    "allow-open-help",
    "allow-open-about",
    "allow-show-context-menu",
    "allow-set-tray-busy",
    "allow-notify-task-complete",
    "allow-close-current-window"
  ]
}
