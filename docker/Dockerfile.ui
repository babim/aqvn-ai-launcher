# Container image for serving AQVN Workspace UI assets
# Target: Ultra-lightweight alpine nginx static server

FROM nginx:1.27-alpine-slim

LABEL org.opencontainers.image.title="AQVN Workspace UI" \
      org.opencontainers.image.description="Static assets and modern Web Components UI for AQVN Workspace" \
      org.opencontainers.image.vendor="AQ Viet Nam Information Technology JSC"

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy workspace UI distribution and Web Components
COPY ui/ /usr/share/nginx/html/

# Custom nginx configuration for SPA routing, compression, and security headers
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    gzip on;\n\
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \.(?:css|js|woff2?|svg|png|jpg|ico)$ {\n\
        expires 7d;\n\
        add_header Cache-Control "public, no-transform";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/index.html | grep -q "AQVN Workspace" || exit 1

CMD ["nginx", "-g", "daemon off;"]
