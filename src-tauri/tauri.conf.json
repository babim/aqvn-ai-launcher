{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AQVN Workspace",
  "version": "0.1.9",
  "identifier": "net.aqvn.workspace",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": {
      "data": "$CONFIG/net.aqvn.workspace"
    },
    "windows": [
      {
        "label": "main",
        "title": "AQVN Workspace",
        "create": false,
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://[IP]:* http://localhost:* ws://[IP]:* ws://localhost:*; img-src 'self' asset: https: data: blob:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none';"
    }
  },
  "plugins": {
    "shell": {
      "open": "^((mailto:\\w+)|(https?://)).+"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
